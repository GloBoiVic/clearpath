{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch*)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list*)",
      "Bash(gh pr ready *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh issue create *)",
      "Bash(gh label create *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment * --body \"Claimed by *\")",

    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh api *merge*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -*)",
      "Bash(git push *HEAD*)",
      "Bash(git push *main*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--delete*)",
      "Bash(git push *-d *)",
      "Bash(git push * :*)",
      "Bash(git -C * push*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh issue comment *--edit-last*)",
      "Bash(gh issue comment *--delete-last*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)",
      "Bash(sudo *)",
      "Bash(networksetup *)",
      "Bash(scutil *)",
      "Bash(profiles *)",
      "Bash(systemextensionsctl *)",
      "Bash(security add-trusted-cert*)",
      "Bash(*live_smoke.py*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(git branch --delete main*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git config *hooksPath*)",
      "Bash(git -c *hooksPath*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh release delete*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-X delete*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(gh api *--method=delete*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
